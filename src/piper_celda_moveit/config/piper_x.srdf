<?xml version="1.0" encoding="UTF-8"?>
<!-- SRDF del PiPER X para la celda Omica.
     La matriz de colisiones se calculo muestreando 3000 configuraciones
     aleatorias dentro de los limites articulares: se desactivan los pares
     adyacentes y los 15 que nunca llegaron a tocarse. Los 19 restantes se
     siguen comprobando en cada plan. -->
<robot name="piper_x">

  <!-- ===================== grupos ===================== -->
  <group name="brazo">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>

  <group name="pinza">
    <joint name="joint7"/>
    <joint name="joint8"/>
  </group>

  <!-- ===================== poses ===================== -->
  <!-- joint2 tiene limite inferior 0 y joint3 superior 0, asi que la pose
       de todo-ceros esta justo sobre dos topes. Estas dos la evitan. -->
  <group_state name="plegado" group="brazo">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="2.6"/>
    <joint name="joint3" value="-2.6"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <group_state name="listo" group="brazo">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="1.2"/>
    <joint name="joint3" value="-1.0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0.6"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <group_state name="abierta" group="pinza">
    <joint name="joint7" value="0.035"/>
    <joint name="joint8" value="-0.035"/>
  </group_state>

  <group_state name="cerrada" group="pinza">
    <joint name="joint7" value="0.0"/>
    <joint name="joint8" value="0.0"/>
  </group_state>

  <!-- ===================== efector ===================== -->
  <end_effector name="efector" parent_link="Link6" group="pinza"
                parent_group="brazo"/>

  <!-- ===================== colisiones ===================== -->
  <!-- adyacentes -->
  <disable_collisions link1="base_link" link2="Link1"        reason="Adjacent"/>
  <disable_collisions link1="Link1"     link2="Link2"        reason="Adjacent"/>
  <disable_collisions link1="Link2"     link2="Link3"        reason="Adjacent"/>
  <disable_collisions link1="Link3"     link2="Link4"        reason="Adjacent"/>
  <disable_collisions link1="Link4"     link2="Link5"        reason="Adjacent"/>
  <disable_collisions link1="Link5"     link2="Link6"        reason="Adjacent"/>
  <disable_collisions link1="Link6"     link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="Link6"     link2="Link7"        reason="Adjacent"/>
  <disable_collisions link1="Link6"     link2="Link8"        reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="Link7"     reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="Link8"     reason="Adjacent"/>

  <!-- nunca se tocaron en 3000 muestras -->
  <disable_collisions link1="base_link" link2="Link2"        reason="Never"/>
  <disable_collisions link1="Link1"     link2="Link3"        reason="Never"/>
  <disable_collisions link1="Link3"     link2="Link5"        reason="Never"/>
  <disable_collisions link1="Link3"     link2="Link6"        reason="Never"/>
  <disable_collisions link1="Link3"     link2="gripper_base" reason="Never"/>
  <disable_collisions link1="Link3"     link2="Link7"        reason="Never"/>
  <disable_collisions link1="Link3"     link2="Link8"        reason="Never"/>
  <disable_collisions link1="Link4"     link2="Link6"        reason="Never"/>
  <disable_collisions link1="Link4"     link2="gripper_base" reason="Never"/>
  <disable_collisions link1="Link4"     link2="Link7"        reason="Never"/>
  <disable_collisions link1="Link4"     link2="Link8"        reason="Never"/>
  <disable_collisions link1="Link5"     link2="gripper_base" reason="Never"/>
  <disable_collisions link1="Link5"     link2="Link7"        reason="Never"/>
  <disable_collisions link1="Link5"     link2="Link8"        reason="Never"/>

  <!-- los dedos se cierran uno contra otro; si no se desactiva, MoveIt
       rechaza cerrar la pinza -->
  <disable_collisions link1="Link7"     link2="Link8"        reason="Default"/>

</robot>
